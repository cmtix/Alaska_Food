############################################
# GLOBAL DEFAULT — IGNORE EVERYTHING
############################################
*

############################################
# UNIGNORE ONLY THE DIRECTORIES WE WANT
############################################
!DATA_CLEANING_SCRIPTS/
!DATA_PULL_SCRIPTS/
!DATA/

# Allow all files inside those allowed directories
!DATA_CLEANING_SCRIPTS/**
!DATA_PULL_SCRIPTS/**
!DATA/**

############################################
# ALLOW .gitignore ITSELF
############################################
!.gitignore


############################################
# IGNORE PYTHON VIRTUAL ENVIRONMENTS
############################################
# Entire Python_setup folder except files you explicitly unignore later
DATA_PULL_SCRIPTS/Python_setup/
DATA_PULL_SCRIPTS/Python_setup/**

# If "Scripts" is also auto-generated (Windows venv)
DATA_PULL_SCRIPTS/Scripts/
DATA_PULL_SCRIPTS/Scripts/**


############################################
# IGNORE DEVELOPMENT/BUILD ARTIFACTS
############################################
DATA_CLEANING_SCRIPTS/ARCHIVE/
DATA_CLEANING_SCRIPTS/.posit/
DATA_CLEANING_SCRIPTS/__pycache__/
DATA_PULL_SCRIPTS/__pycache__/
__pycache__/


############################################
# IGNORE RStudio / Posit NOISE
############################################
.Rhistory
.RData
.Rproj.user/
*.Rproj


############################################
# IGNORE OS JUNK
############################################
Thumbs.db
desktop.ini
.DS_Store
